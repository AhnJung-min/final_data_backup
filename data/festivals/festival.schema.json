              "title",
              "venue",
              "start_date",
              "end_date",
              "program",
              "organizer",
              "host",
              "sponsor",
              "contact",
              "homepage",
              "related_info",
              "road_address",
              "jibun_address",
              "address",
              "time",
              "price",
              "region",
              "district",
              "service",
              "category",
              "venue_url",
              "gps.lat",
              "gps.lng"
            ]
          }
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label_region"
          }
        },
        "external_event_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              },
              "changes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "before": {},
                    "after": {},
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "path",
                    "before",
                    "after",
                    "reason"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "version",
              "reviewer",
              "reviewed_at",
              "changes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "review_status",
        "version",
        "reviewer",
        "reviewed_at",
        "coordinate_space",
        "event",
        "approved_fields",
        "regions",
        "external_event_verified",
        "history"
      ],
      "additionalProperties": false,
      "description": "사람 정답·검토 기록. API 또는 모델 관찰값을 자동으로 복사하거나 승인하지 않음.",
      "allOf": [
        {
          "if": {
            "properties": {
              "review_status": {
                "enum": [
                  "approved",
                  "partially_approved"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "version": {
                "type": "string",
                "minLength": 1
              },
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewed_at": {
                "type": "string",
                "minLength": 1,
                "format": "date-time"
              }
            }
          }
        }
      ]
    },
    "dataset": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "split": {
          "enum": [
            "unassigned",
            "train",
            "validation",
            "test"
          ]
        },
        "training_eligible": {
          "type": "boolean"
        },
        "evaluation_eligible": {
          "type": "boolean"
        },
        "exclusion_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "version",
        "group_id",
        "split",
        "training_eligible",
        "evaluation_eligible",
        "exclusion_reasons"
      ],
      "additionalProperties": false,
      "description": "원본 SHA-256을 group_id로 사용. 같은 원본의 crop·전처리·증강은 같은 split을 사용. 승인되지 않은 정답은 학습·정식 평가에서 제외."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "2.1.0"
          }
        }
      },
      "then": {
        "required": [
          "ocr",
          "labels",
          "dataset"
        ],
        "properties": {
          "image": {
            "required": [
              "display"
            ],
            "properties": {
              "source": {
                "required": [
                  "image_name",
                  "serial_number",
                  "raw_response_item"
                ]
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "ocr"
              ]
            },
            {
              "required": [
                "labels"
              ]
            },
            {
              "required": [
                "dataset"
              ]
            },
            {
              "properties": {
                "image": {
                  "required": [
                    "display"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  ]
}

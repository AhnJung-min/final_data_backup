+def clock_span(first, second):
+    """'1900-2200'처럼 두 쪽이 모두 정각·30분 시각이고 앞이 더 이르면 시각 범위로 본다."""
+    return all(int(x[:2]) <= 24 and x[2:] in ("00", "30") for x in (first, second)) and first < second

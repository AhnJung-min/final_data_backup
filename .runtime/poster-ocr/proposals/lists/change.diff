+def sns_handle(raw):
+    """'@계정'은 5자 이상, 글자 3자 이상이고 글자가 숫자보다 많을 때만 받는다."""
+    handle = raw[1:].strip("._")
+    letters = sum(ch.isalpha() for ch in handle)
+    return len(handle) >= 5 and letters >= 3 and letters > sum(ch.isdigit() for ch in handle)
+
